# ---- Public URLs ----
# The public address of your server, e.g. https://app.duechat.com
SITE_URL=https://app.example.com
API_EXTERNAL_URL=https://app.example.com/api

# ---- Secrets (generate each with: openssl rand -base64 32) ----
POSTGRES_PASSWORD=CHANGEME
JWT_SECRET=CHANGEME
SECRET_KEY_BASE=CHANGEME

# ---- API keys ----
# These are JWTs signed with JWT_SECRET. Generate them with the script:
#   ./generate-keys.sh
ANON_KEY=CHANGEME
SERVICE_ROLE_KEY=CHANGEME

# ---- Outgoing email (account confirmation, password reset) ----
# Any SMTP provider works (your host, Gmail app password, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGEME
SMTP_PASS=CHANGEME
SMTP_ADMIN_EMAIL=admin@example.com
